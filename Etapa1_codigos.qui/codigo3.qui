/--
  codigo3.qui
  Foco em funcoes de alta ordem personalizadas, assinaturas sem parametros,
  assinatura aninhada, chamada sem argumentos e uso das funcoes matematicas.
--/

-- Funcao de Minimo
[ numero Minimo [ numero valX | numero valY ] :
  [
    || < valX << valY > = valX
    || # = valY
  ]
]

-- Processa binario
[ numero ProcessaBinario [ numero valA | numero valB | numero Operacao [ numero | numero ] ] :
  Operacao [ valA | valB ]
]

-- Funcao sem parametros 
[ numero ObtemConstante [ ] :
  Logaritmo [ 100,0 ]
]

-- Funcao que recebe uma assinatura sem parametros
[ numero ExecutaSemArg [ numero Executador [ ] ] :
  Executador [ ]
]

-- Assinatura aninhada (parametro_assinatura -> assinatura)
[ numero ProcessadorAvancado [ numero SuperOp [ numero | numero Aux [ numero ] ] ] :
  0
]

-- Funcao de alta ordem e chamadas trigonometrica
[ numero TestaAltaOrdem [ numero parametroBase ] :
  [
    [ ¨ numero res1 [ ProcessaBinario [ parametroBase | 0b10 | Minimo ] ] ]
    [ ¨ numero res2 [ ExecutaSemArg [ ObtemConstante ] ] ]
    
    < Cosseno [ res1 ] + Tangente [ res2 ] >
  ]
]
