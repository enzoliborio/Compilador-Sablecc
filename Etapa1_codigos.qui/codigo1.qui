/--
  codigo1.qui
  Testa o marcador principal, blocos de expressao, constantes, e
  tipos primitivos (decimal, binario, real), operadores aritmeticos basicos (+, -, ., /, //, \, ‘) e precedencia ('<' exp '>') .
--/

++ [ numero Principal [ ] :
  [
    [ ¨  numero valorDec [ 5,75 ] ]
    [ ¨  numero valorBin [ 0b1011 ] ]
    [ ¨  numero valorNeg [ - valorDec ] ]
    
    -- Expressao matematica complexa alterando a precedencia com ( '<' exp '>' )
    < < valorDec + valorBin > . < valorBin - valorNeg > > / < < Seno [ valorDec ] // <2 \ 3> > ' 2>
  ]
]
