-- codigo2.qui
-- Foco em guardas, operadores relacionais, logicos e recursao.

[ numero Fatorial [ numero num ] :
  [
    || < num == 0 > v < num == 1 > = 1
    || < num << 0 > = - 1 
-- menos um de retorno para demonstrar que houve erro, o fatorial não pode ser menor que zero , porque não pertence ao conjunto dos inteiros
    || # = < num . Fatorial [ num-1 ] >
  ]
]

[ booleano ValidaLogica [ booleano valA | booleano valB ] :
  [
    || < valA ^ valB > = V
    || ¬ valA = F
    || # = < valA v valB >
  ]
]